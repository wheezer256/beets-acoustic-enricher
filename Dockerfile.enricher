# Example: add the plugin to an existing beets image.
FROM your-existing-beets-image

# ffmpeg is required for sampling (Debian/Ubuntu base; use `apk add ffmpeg` on Alpine)
RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*

# SDKs: google-genai for gemini/batch, requests for openai/llamacpp/ollama
RUN pip install google-genai requests pyyaml

# Mount the repository and point beets' pluginpath at it, or bake it in:
# COPY . /opt/beets-acoustic-enricher
# (config.yaml)  pluginpath: [/opt/beets-acoustic-enricher]
